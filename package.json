{
  "name": "airbnb-clone",
  "version": "1.0.0",
  "description": "Full-stack Airbnb travel listing and booking platform built with Node.js, Express, React, and MongoDB",
  "main": "backend/server.js",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "keywords": [
    "airbnb",
    "mern",
    "react",
    "express",
    "mongodb",
    "travel-booking",
    "full-stack"
  ],
  "author": "Sathwik Ryapaka",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
